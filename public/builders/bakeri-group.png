<script>
    jQuery("#booking_form input[name=ovabrw_number_vehicle]").keypress(function (evt) {
    evt.preventDefault();
});


jQuery(document).ajaxComplete(function(){

      jQuery("#booking_form input[name=ovabrw_number_vehicle]").keypress(function (evt) {
          evt.preventDefault();
      });

      jQuery("#booking_form select[name=adultsandchildrens]").prop('disabled', true);
      jQuery("#booking_form select[name=adultsandchildrensnight]").prop('disabled', true);

      jQuery(".rental_item label:nth-child(3)").text("No. of Rooms");

      jQuery(".variation dt.variation-Quantity").text("No. of Rooms:");


      var adultnamefield = jQuery("#booking_form select.adult").attr("name");

      //console.log("Adult: "+adultnamefield);


      var noofrooms = jQuery("#booking_form input[name=ovabrw_number_vehicle]").val();

        if(adultnamefield == "adultsandchildrens"){

          
            var one1 = parseInt(noofrooms, 10);
            var two1 = parseInt(4, 10);
            var totaladults = (one1 * two1);

            var adult_string = totaladults + " Persons ( ex: Adults/Children)";    
            jQuery("#booking_form select[name=adultsandchildrens]").prop('disabled', false);
            jQuery('#booking_form  select[name=adultsandchildrens] option:contains('+ adult_string +')').prop('selected',true);
            jQuery("#booking_form select[name=adultsandchildrens]").prop('disabled', true);
        }

        else{
            var one = parseInt(noofrooms);
            var two = parseInt(4);

            /*var one = parseInt(noofrooms);
            var two = parseInt(4);*/
            var totaladults1 = (one * two);

            var adult_string1 = totaladults1 + " Persons ( ex: Adults/Children)";    

            console.log(adult_string1);

            jQuery("#booking_form select[name=adultsandchildrensnight]").prop('disabled', false);
            //jQuery('#booking_form  select[name=adultsandchildrensnight] option:contains('+ adult_string1 +')').prop('selected',true);

            jQuery('#booking_form  select[name=adultsandchildrensnight] option:selected').text(adult_string1);

            jQuery("#booking_form select[name=adultsandchildrensnight]").prop('disabled', true);
        }

var page_id = 1095;


if (page_id !== 2620 && page_id !== 2619 && page_id !== 2451){
    
          /*jQuery("#booking_form input[name=ovabrw_number_vehicle]").attr({
             "max" : 4,        // substitute your own
             "min" : 1          // values (or variables) here
      });*/
}


      jQuery("#booking_form input[name=ovabrw_number_vehicle]").val(noofrooms); 

      jQuery('.rental_item .period_package select option:contains("Day Stay")').prop('selected',true);

});


jQuery(document).ready(function(){

var day = jQuery(".period_package select option[value='1']").filter(":selected").text("Day Stay");	
console.log(day);

jQuery(".period_package select option[value='0']").hide();


if(day = "Day Stay")
{

	jQuery(".ovabrw_datetimepicker.ovabrw_start_date.startdate_perido_time").on('change', function() 
	{
		jQuery(".period_package select option[value='1']:selected").prop("selected", false);
		jQuery(".period_package select option[value='1']").prop("selected", "selected");

		jQuery(".period_package select option[value='0']").hide();
	});
	jQuery(".period_package select option[value='0']").hide();
}


});

</script>
 <script type="text/javascript">
    jQuery(document).ready(function(){
       
       var fulltext = jQuery(".wc-item-meta li p").html();
     
        var string = fulltext.split(" ");
        jQuery(".wc-item-meta li:nth-child(1) p").html(string[0]);
         jQuery(".wc-item-meta li:nth-child(2) p").html(string[0]);
       
    });
</script>  
</body>  
</html>