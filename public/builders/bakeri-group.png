/*.marquee-text-animation {
    position: absolute;
    top: -77vh;
}*/
.marquee {
    font-size: calc(315px / 1.1);
  }
.text1 {
    max-width: 320px;
}
.marquee-wrap {
    /* position: relative; */
    margin-top: 0px;
    margin-bottom: 0px;
    display: block;
    white-space: nowrap;
    padding: 0 46px;
}
.marquee {
    position: relative;
    display: table;
    font-size: 100px;
    letter-spacing: -0.01em;
    z-index: 2;
    font-weight: 400;
    color: #37773b;
    -webkit-animation: backward-infinite2 10s linear infinite;
    animation: backward-infinite2 10s linear infinite;
    will-change: transform;
    line-height: 91px;
    font-family: 'Archivo Black', sans-serif !important;
}

.marquee::after {
    content: attr(data-title);
    padding-left: 2.375em;
}
.marquee:before {
    content: attr(data-title);
    padding-right: 2.375em;
}
.marquee-wrap .marquee:last-child {
    animation-direction: reverse;
    z-index:1;
}

@-webkit-keyframes backward-infinite2 {
  0% {
    -webkit-transform: translate3D(0, 0, 0);
    transform: translate3D(0, 0, 0);
  }
  to {
    -webkit-transform: translate3D(calc((-100% / 3) - 0.333333em), 0, 0);
    transform: translate3D(calc((-100% / 3) - 0.333333em), 0, 0);
  }
}
@keyframes backward-infinite2 {
  0% {
    -webkit-transform: translate3D(0, 0, 0);
    transform: translate3D(0, 0, 0);
  }
  to {
    -webkit-transform: translate3D(calc((-100% / 3) - 1.333333em), 0, 0);
    transform: translate3D(calc((-100% / 3) - 1.333333em), 0, 0);
  }
}

