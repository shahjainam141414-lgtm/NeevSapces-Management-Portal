}

/* Smooth transition for hover states */
.project-details-desktop .main-menus a {
    transition: opacity 0.7s ease, color 0.7s ease;
    opacity: 1;
}

/* Mobile menu active state */
.project-details-mobile .menu-list a.active {
    color: #000 !important;
    font-weight: 600;
}
</style>
