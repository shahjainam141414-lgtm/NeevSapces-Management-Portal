    <style>
    button.play_active.active {
      color: #000;
      background: #7dcbb6;
      height: 50px!important;
      min-height: 50px!important;
      width: auto!important;
      padding: 10px 30px;
    }
    button.play_active {
      background-color: transparent;
      border: medium none;
      color: #000;
      display: block;
      font-size: 24px;
      position: absolute;
      z-index: 999;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%); 
      padding: 8px 16px;  
      height: 100%;
      width: 100%;
    }
    </style>
	
